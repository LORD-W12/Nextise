generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./seminar.db"
}

model Trainer {
  id           String   @id @default(uuid())
  name         String
  subjects     String
  location     String
  email        String   @unique
  availability String   @default("[]")
  hourlyRate   Float?
  rating       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  courses      Course[]

  @@index([email])
}

model Course {
  id               String    @id @default(uuid())
  name             String
  date             DateTime
  endDate          DateTime?
  subject          String
  location         String
  participants     Int
  notes            String    @default("")
  price            Float
  trainerPrice     Float     @default(0.0)
  status           String    @default("scheduled")
  trainerId        String?
  trainer          Trainer?  @relation(fields: [trainerId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([trainerId])
  @@index([date])
}
