# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Default to Postgres in Docker for local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seminar_db?schema=public"

# Auth Settings
JWT_SECRET="dev_jwt_secret_for_entry_test"
ADMIN_USERNAME="admin"
# bcrypt hash for "password"
ADMIN_PASSWORD_HASH='$2b$12$AafJaMU.tf0lP69u/JTiyei.F/HYPYwLxnrip0LlnUA2IzuYEq6DK'

# Email Settings (Mailhog local)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@seminar-hub.local"

# AI Service Settings
GEMINI_API_KEY=""

